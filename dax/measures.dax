// Dynamic callout label for Revenue: shows last week value (auto-scaled K/M/Bn) and WoW % change with directional arrow.
[Callout Label Text Revenue] =
    VAR selv = IF(HASONEFILTER(dim_date[wn]),SELECTEDVALUE(dim_date[wn]),MAX(dim_date[wn]))
    VAR cw = CALCULATE([Revenue], dim_date[wn] = selv)
    VAR pw = CALCULATE([Revenue], FILTER(ALL(dim_date), dim_date[wn] = selv-1))
    VAR chg = DIVIDE(cw,pw,0)-1
    RETURN
    SWITCH(TRUE(),
        pw = BLANK(), "PRIOR WEEK NOT AVAILABLE",
        chg > 0 && pw < 1000000, "LW: " & ROUND(pw/1000,1) & "K  |  " & ROUND(chg*100,1) & "%  " & UNICHAR(9650),
        chg > 0 && pw < 1000000000, "LW: " & ROUND(pw/1000000,2) & "M  |  " & ROUND(chg*100,1) & "%  " & UNICHAR(9650),
        chg > 0, "LW: " & ROUND(pw/1000000000,2) & "Bn  |  " & ROUND(chg*100,1) & "%  " & UNICHAR(9650),
        chg < 0 && pw < 1000000, "LW: " & ROUND(pw/1000,1) & "K  |  " & ROUND(chg*100,1) & "%  " & UNICHAR(9660),
        chg < 0 && pw < 1000000000, "LW: " & ROUND(pw/1000000,2) & "M  |  " & ROUND(chg*100,1) & "%  " & UNICHAR(9660),
        chg < 0, "LW: " & ROUND(pw/1000000000,2) & "Bn  |  " & ROUND(chg*100,1) & "%  " & UNICHAR(9660),
        "LW: " & ROUND(pw/1000000,2) & "M  |  0.0%  " & UNICHAR(8594)
    )

// ==================================================
// CONDITIONAL FORMATTING
// Colour codes returned to visuals through the fx (field value) option.
// ==================================================

// Rating colour in the property table: green 3.5+, amber above 2.5, red 2.5 or below
[Average Rating Txt Color] =
    SWITCH(
        TRUE(),
        ISBLANK([Average Rating]),"Grey",
        [Average Rating]>= 3.5 , "Green",
        [Average Rating]< 3.5 && [Average Rating]>2.5 , "#F8CD63",
        [Average Rating]<=2.5 , "Red"
    )

// Accent bar colour for ADR card: green if up WoW, red if down, grey if no change.
[COLOR Accent Bar ADR] =
    VAR chg = [ADR WoW change %]
    RETURN
    SWITCH(TRUE(),
        ISBLANK(chg), "#BFBFBF",
        ROUND(chg, 3) = 0, "#BFBFBF",
        chg > 0, "#40916C",
        "#DA3D4D"
    )

// Accent bar colour for Cancellation % card (inverse metric): red if up WoW, green if down, grey if no change.
[COLOR Accent Bar Cancellation] =
    VAR chg = [Cancellation WoW change %]
    RETURN
    SWITCH(TRUE(),
        ISBLANK(chg), "#BFBFBF",
        ROUND(chg, 3) = 0, "#BFBFBF",
        chg > 0, "#DA3D4D",
        "#40916C"
    )

// Accent bar colour for DSRN card: green if up WoW, red if down, grey if no change.
[COLOR Accent Bar DSRN] =
    VAR chg = [DSRN WoW change %]
    RETURN
    SWITCH(TRUE(),
        ISBLANK(chg), "#BFBFBF",
        ROUND(chg, 3) = 0, "#BFBFBF",
        chg > 0, "#40916C",
        "#DA3D4D"
    )

